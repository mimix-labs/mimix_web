# Configuración local del backend Mimix Web.
PORT=4000

# Laptop: usa la webcam y MediaPipe dentro del navegador.
MIMIX_VISION_MODE=browser

# Jetson: descomenta este valor para consumir landmarks por SSE y video MJPEG.
# MIMIX_VISION_MODE=jetson

# URL opcional del stream MJPEG producido en la Jetson.
# MIMIX_VISION_VIDEO_URL=http://127.0.0.1:8081/stream.mjpg

# Debe coincidir con MIMIX_ROBOT_BRIDGE_TOKEN de mimix_robot/.env.
# Déjalo vacío únicamente para el primer piloto en una Jetson aislada.
# MIMIX_ROBOT_BRIDGE_TOKEN=replace-with-a-long-local-secret

# Habilita el modal de control físico. Debe ser distinto del token interno del
# robot y se introduce manualmente en el navegador; nunca se incluye en el build.
# MIMIX_ROBOT_CONTROL_TOKEN=replace-with-a-different-long-secret

# Runtime de la fundación API. express permite rollback temporal tras reiniciar.
MIMIX_API_RUNTIME=nest
# Logs JSON; nunca se registran headers, query strings ni payloads.
LOG_LEVEL=info
# HOST=0.0.0.0

# Activación incremental; legacy conserva las rutas públicas inventariadas.
# Cambiar a clerk SOLO después de completar docs/runbooks/identity-clerk.md.
MIMIX_AUTH_MODE=legacy
# Orígenes exactos, sin slash final. Producción: configurar dominio HTTPS real.
MIMIX_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
# Cuotas por minuto y ruta normalizada; health exento. No confiar en X-Forwarded-For.
# MIMIX_RATE_LIMIT solo controla rutas públicas de compatibilidad, salvo landmarks.
MIMIX_RATE_LIMIT=1200
MIMIX_RATE_LIMIT_ANONYMOUS=60
MIMIX_RATE_LIMIT_USER=120
MIMIX_RATE_LIMIT_MACHINE=600
# Separado para aceptar 30 FPS (1800/min) con margen, en legacy y clerk.
MIMIX_RATE_LIMIT_LANDMARKS=3600
# En modo clerk: ruta ABSOLUTA en volumen persistente; una sola réplica.
# MIMIX_IDENTITY_FILE=/data/mimix/identity.json
# CLERK_SECRET_KEY=sk_test_replace-locally
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Opcional: clave PÚBLICA PEM para verificar JWT sin descargar JWKS.
# CLERK_JWT_KEY=

# PostgreSQL learning history: off by default; requires MIMIX_AUTH_MODE=clerk.
# Set secrets using the environment manager; migrate/import identities before activation.
MIMIX_DATA_STORE=file
# DATABASE_URL=postgresql://app_user:replace-locally@localhost:5432/mimix
# Test only: disposable PostgreSQL with CREATEDB for isolated integration databases.
# MIMIX_TEST_DATABASE_URL=postgresql://test_user:replace-locally@localhost:5432/postgres
