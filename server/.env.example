# Configuración local del backend Mimix Web.
PORT=4000

# Laptop: usa la webcam y MediaPipe dentro del navegador.
MIMIX_VISION_MODE=browser

# Jetson: descomenta este valor para consumir landmarks por SSE y video MJPEG.
# MIMIX_VISION_MODE=jetson

# URL opcional del stream MJPEG producido en la Jetson.
# MIMIX_VISION_VIDEO_URL=http://127.0.0.1:8081/stream.mjpg

# Debe coincidir con MIMIX_ROBOT_BRIDGE_TOKEN de mimix_robot/.env.
# Déjalo vacío únicamente para el primer piloto en una Jetson aislada.
# MIMIX_ROBOT_BRIDGE_TOKEN=replace-with-a-long-local-secret

# Habilita el modal de control físico. Debe ser distinto del token interno del
# robot y se introduce manualmente en el navegador; nunca se incluye en el build.
# MIMIX_ROBOT_CONTROL_TOKEN=replace-with-a-different-long-secret
