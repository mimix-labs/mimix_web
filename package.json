{
  "name": "mimix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "client": "pnpm --filter mimix-client dev",
    "server": "turbo run dev --filter @mimix/api",
    "start": "pnpm --filter @mimix/api start",
    "install:all": "pnpm install",
    "ci:install": "pnpm install --frozen-lockfile",
    "lint": "turbo run lint:repo",
    "lint:repo": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck:repo typecheck",
    "typecheck:repo": "tsc --project jsconfig.json",
    "test": "turbo run test:repo test",
    "test:repo": "node --test test/smoke/api.test.js test/smoke/frontend.test.js test/contracts/*.test.js test/challenges/*.test.js",
    "test:smoke": "turbo run test:production",
    "test:production": "node --test test/smoke/production.test.js",
    "check": "turbo run lint:repo typecheck:repo typecheck test:repo test test:production",
    "test:browser": "turbo run test:browser --filter @mimix/challenge-runtime --filter mimix-client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.5.2",
    "@types/punycode": "^2.1.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "railway": "^3.11.0",
    "turbo": "2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  }
}
