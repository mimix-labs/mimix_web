# Opt-in shell; the existing Vite/API deployment remains unchanged.
MIMIX_WEB_AUTH_MODE=disabled
MIMIX_API_ORIGIN=http://127.0.0.1:4000
MIMIX_LEGACY_ORIGIN=http://localhost:5173
# Set clerk mode with both keys from the SAME instance as the API.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless JWT signature verification in Next.
# The API still checks active sessions independently. Never set a test key in production.
CLERK_JWT_KEY=

# Migration selector: legacy (default rollback) or next (/play).
MIMIX_WORLD_MODE=legacy
