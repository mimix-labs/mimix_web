{
  "name": "@mimix/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/world-assets.mjs && next dev --turbopack --port 3100",
    "build": "node scripts/world-assets.mjs && next build --turbopack && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "test:container": "node --test test/container.test.js",
    "test:contracts": "tsx --test test/contracts/*.test.js"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@clerk/nextjs": "7.9.11",
    "server-only": "0.0.1",
    "zod": "4.6.5",
    "@mimix/contracts": "workspace:*",
    "@mimix/challenge-mathematics": "workspace:*",
    "@mimix/challenge-science": "workspace:*",
    "@mimix/world": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.3",
    "tsx": "4.23.15",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "^4.11.0"
  }
}
