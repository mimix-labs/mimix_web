{
  "name": "@mimix/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js && MIMIX_CONTRACT_RUNTIME=nest node --test ../../test/contracts/legacy.test.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@clerk/backend": "3.22.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "dotenv": "^16.4.0",
    "fastify": "5.12.5",
    "mimix-server": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.5.2",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
