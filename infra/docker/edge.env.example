MIMIX_PLATFORM=linux/arm64
MIMIX_RUNTIME_IMAGE=mimix-runtime:dev
MIMIX_SIMULATOR_IMAGE=mimix-simulator:dev
MIMIX_EDGE_BIND=127.0.0.1
MIMIX_EDGE_PORT=4080
MIMIX_EDGE_ORIGINS=http://localhost:4080,http://127.0.0.1:4080
# Provision distinct private tokens before enabling the simulator or bridge.
MIMIX_ROBOT_BRIDGE_TOKEN=
MIMIX_ROBOT_CONTROL_TOKEN=
# Host vision must listen on a Docker-reachable host interface, not only loopback.
MIMIX_VISION_VIDEO_URL=http://host.docker.internal:8081/stream.mjpg

# Para cola SQLite, añadir -f infra/docker/offline.compose.yaml al despliegue.
# No usar edge-release.sh del perfil base para ese despliegue opt-in.
MIMIX_SYNC_CLOUD_ORIGIN=
