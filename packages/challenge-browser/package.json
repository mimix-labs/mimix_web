{
  "name": "@mimix/challenge-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three.js": "./dist/three.js",
    "./cameraViewport.js": "./dist/cameraViewport.js",
    "./challengeHelp.css": "./src/challengeHelp.css"
  },
  "files": [
    "dist",
    "src/*.css",
    "src/surface.html",
    "src/manifest.json",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/three.js --bundle --format=esm --outfile=dist/three.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mimix/challenge-sdk": "workspace:*",
    "three": "0.128.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "esbuild": "0.28.2"
  }
}
