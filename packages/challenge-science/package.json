{
  "name": "@mimix/challenge-science",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./surface.html": "./src/surface.html",
    "./styles.css": "./src/styles.css",
