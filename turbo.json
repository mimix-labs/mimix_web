{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheDir": ".turbo/cache",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "MIMIX_*",
        "LOG_LEVEL",
        "NODE_ENV"
      ]
    },
    "//#lint:repo": {
      "cache": false
    },
    "//#typecheck:repo": {
      "cache": false,
      "dependsOn": [
        "@mimix/api#build"
      ]
    },
    "//#test:repo": {
      "cache": false
    },
    "//#test:production": {
      "dependsOn": [
        "mimix-client#build",
        "@mimix/api#build"
      ],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "typecheck": {
      "cache": false
    }
  }
}
