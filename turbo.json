{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheDir": ".turbo/cache",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VITE_MIMIX_CHALLENGES_MODE"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "MIMIX_*",
        "CLERK_*",
        "DATABASE_URL",
        "LOG_LEVEL",
        "NODE_ENV",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "//#lint:repo": {
      "cache": false
    },
    "//#typecheck:repo": {
      "cache": false,
      "dependsOn": [
        "@mimix/api#build",
        "@mimix/challenge-mathematics#build",
        "@mimix/challenge-science#build"
      ]
    },
    "//#test:repo": {
      "cache": false,
      "dependsOn": [
        "@mimix/challenge-mathematics#build",
        "@mimix/challenge-science#build"
      ]
    },
    "//#test:production": {
      "dependsOn": [
        "mimix-client#build",
        "@mimix/api#build"
      ],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "typecheck": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "@mimix/challenge-sdk#typecheck": {
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "@mimix/challenge-runtime#typecheck": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "@mimix/web#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "public/assets/models/**",
        "public/vendor/draco/**"
      ],
      "env": [
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"
      ],
      "passThroughEnv": [
        "MIMIX_WEB_AUTH_MODE",
        "MIMIX_API_ORIGIN",
        "MIMIX_LEGACY_ORIGIN",
        "CLERK_SECRET_KEY",
        "CLERK_JWT_KEY",
        "MIMIX_WORLD_MODE"
      ]
    }
  }
}
